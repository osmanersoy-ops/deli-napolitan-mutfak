# Sunucu Portu
PORT=3000

# Adisyo API Bilgileri (Adisyo Panel > Ayarlar > Entegrasyonlar / API)
ADISYO_API_KEY=your_adisyo_api_key_here
ADISYO_API_SECRET=your_adisyo_api_secret_here
ADISYO_API_CONSUMER=your_adisyo_consumer_here

# Adisyo API Temel Adresi
ADISYO_BASE_URL=https://ext.adisyo.com/api/External/v2

# Pizza Filtreleme Kelimeleri (Virgülle ayrılmış, büyük/küçük harf duyarsız)
# Ürün veya kategori adı bu kelimelerden birini içeriyorsa ekrana yansıtılır.
PIZZA_KEYWORDS=Pizza,Pizzalar,Napolitan,Calzone,Pizzetta

# Adisyo RecentOrders Arka Plan Senkronizasyon Aralığı (Saniye, min 25s)
SYNC_INTERVAL_SECONDS=30
